# Copie para .env (uso local) ou cadastre no Coolify em "Environment Variables".

# Gere com: docker run --rm php:8.4-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=https://api.seudominio.com

DB_DATABASE=classtrack
DB_USERNAME=classtrack
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# URL publica do backend usada pelo frontend (sem /api no final).
# No Coolify, marque como "Build Variable".
VITE_API_URL=https://api.seudominio.com

# E-mail do codigo PIN de cadastro. Com "log", o PIN aparece nos logs do backend.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=no-reply@seudominio.com

# Roda o DatabaseSeeder no primeiro deploy (somente com o banco vazio).
# Cria o login de teste admin@admin.com / password.
RUN_SEEDER=true
